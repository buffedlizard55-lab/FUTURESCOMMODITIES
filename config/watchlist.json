    ]
  },
  "benchmarks": {
    "fred": {
      "enabled": true,
      "note": "FRED CSV downloads are keyless. Where a series is the EIA spot series re-published by the Federal Reserve Bank of St. Louis, both publishers are named on the record.",
      "series": "configured_in_config/competition.json -> benchmarks block; kept here for review"
    },
    "eia_archive": [
      {
        "series_id": "RCLC1",
        "url": "https://www.eia.gov/dnav/pet/hist_xls/RCLC1d.xls",
        "description": "Cushing OK WTI futures contract 1 (historical only: EIA stopped publishing futures prices after 2024-04-05)"
      },
      {
        "series_id": "RNGWHHD",
        "url": "https://www.eia.gov/dnav/ng/hist_xls/RNGWHHDd.xls",
        "description": "Henry Hub natural gas spot price (daily)"
      }
    ]
  },
  "usda": {
    "enabled": true,
    "queries": [
      "livestock",
      "dairy"
    ],
    "reports": [
      {
        "slug_id": 2453,
        "name": "National Daily Boxed Beef Cutout & Boxed Beef Cuts - Negotiated Sales (USDA AMS)"
      },
      {
        "slug_id": 2466,
        "name": "5 Area Daily Weighted Average Direct Slaughter Cattle - Negotiated (USDA AMS)"
      }
    ]
  }
