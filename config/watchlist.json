{
  "_readme": [
    "What the competition is allowed to look at.",
    "",
    "kalshi.classification_rules is the only place where a Kalshi series becomes a commodity in",
    "this project. Rules are tested in order against '<series ticker> <series title>'. A series",
    "that matches no rule is recorded as Unclassified and is NEVER traded: the platform does not",
    "guess what an unlabelled market is about.",
    "",
    "The first rule deliberately excludes cross-commodity ratio markets (e.g. gold vs silver),",
    "which are not a price for a single commodity and therefore must not be traded as one."
  ],
  "kalshi": {
    "category": "Commodities",
    "max_series": 200,
    "max_pages_per_series": 2,
    "max_quoted_markets": 45,
    "max_perps": 12,
    "perp_asset_classes": [
      "Metals"
    ],
    "classification_rules": [
      {
        "pattern": "gold[^a-z]{0,12}vs[^a-z]{0,12}silver|silver[^a-z]{0,12}vs[^a-z]{0,12}gold|goldvs",
        "commodity": null,
        "group": "Excluded",
        "note": "Cross-commodity ratio market: it is not a price for a single commodity and is excluded from trading."
      },
      {
        "pattern": "\\bgold\\b|gold|\\bXAU\\b",
        "commodity": "Gold",
        "group": "Precious Metals"
      },
      {
        "pattern": "\\bsilver\\b|silver|\\bXAG\\b",
        "commodity": "Silver",
        "group": "Precious Metals"
      },
      {
        "pattern": "platinum",
        "commodity": "Platinum",
        "group": "Precious Metals"
      },
      {
        "pattern": "palladium",
        "commodity": "Palladium",
        "group": "Precious Metals"
      },
      {
        "pattern": "copper",
        "commodity": "Copper",
        "group": "Industrial Metals"
      },
      {
        "pattern": "\\bwti\\b|crude|west texas",
        "commodity": "WTI Crude Oil",
        "group": "Energy"
      },
      {
        "pattern": "brent",
        "commodity": "Brent Crude Oil",
        "group": "Energy"
      },
      {
        "pattern": "\\baaa\\b|gas price|pump price|retail gas",
        "commodity": "Gasoline (US retail average)",
        "group": "Energy"
      },
      {
        "pattern": "natural gas|natgas|henry hub|\\bngas\\b",
        "commodity": "Natural Gas",
        "group": "Energy"
      },
      {
        "pattern": "heating oil|diesel|distillate|ulsd",
        "commodity": "Diesel / Heating Oil",
        "group": "Energy"
      },
      {
        "pattern": "gasoline|\\brbob\\b",
        "commodity": "Gasoline",
        "group": "Energy"
      },
      {
        "pattern": "cocoa",
        "commodity": "Cocoa",
        "group": "Soft Commodities"
      },
      {
        "pattern": "coffee",
        "commodity": "Coffee",
        "group": "Soft Commodities"
      },
      {
        "pattern": "sugar",
        "commodity": "Sugar",
        "group": "Soft Commodities"
      },
      {
        "pattern": "cotton",
        "commodity": "Cotton",
        "group": "Soft Commodities"
      },
      {
        "pattern": "orange juice|\\bFCOJ\\b",
        "commodity": "Orange Juice",
        "group": "Soft Commodities"
      },
      {
        "pattern": "\\bcorn\\b",
        "commodity": "Corn",
        "group": "Grains & Oilseeds"
      },
      {
        "pattern": "wheat",
        "commodity": "Wheat",
        "group": "Grains & Oilseeds"
      },
      {
        "pattern": "soybean|\\bsoy\\b",
        "commodity": "Soybeans",
        "group": "Grains & Oilseeds"
      },
      {
        "pattern": "\\boats\\b|oat ",
        "commodity": "Oats",
        "group": "Grains & Oilseeds"
      },
      {
        "pattern": "\\brice\\b",
        "commodity": "Rice",
        "group": "Grains & Oilseeds"
      },
      {
        "pattern": "lumber|timber",
        "commodity": "Lumber",
        "group": "Lumber & Other"
      },
      {
        "pattern": "lithium",
        "commodity": "Lithium",
        "group": "Industrial Metals"
      },
      {
        "pattern": "uranium",
        "commodity": "Uranium",
        "group": "Energy"
      },
      {
        "pattern": "milk|dairy|butter|cheese|whey",
        "commodity": "Dairy",
        "group": "Dairy"
      }
    ],
    "max_market_pages": 8
  },
  "moex": {
    "max_contracts": 44,
    "min_volume_today": 10,
    "asset_codes_note": "Asset codes verified against the exchange's own FORTS listing on 2026-09-22. Codes that do not exist in the listing (PALL, BRENT, NGAS, DAMILK, CORN, SOY, RICE, LEAD) are kept as documented requests: the classifier only ever trades a code the exchange itself publishes, so a missing code simply trades nothing rather than guessing a substitute.",
    "asset_codes": [
      "GOLD",
      "GOLDM",
      "SILV",
      "SILVM",
      "PLT",
      "PLTM",
      "PALL",
      "COPPER",
      "NICKEL",
      "ALUM",
